{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].cjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/manus-storage/(.*)", "destination": "/api/[...path].cjs" },
    { "source": "/api/(.*)", "destination": "/api/[...path].cjs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
